---
import ventures from '../content/ventures.json';
import { ICONS } from '../lib/icons';
import { keepFigures } from '../lib/format';
---
<section class="sec" id="projects" aria-labelledby="proj-h">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">Ventures &amp; research</p>
      <h2 class="display h2" id="proj-h">Built &amp; Building<span class="dot">.</span></h2>
    </div>
    <div class="proj-grid">
      {ventures.items.map((v) => (
        <article class:list={['card pcard rv', { feat: v.featured }]}>
          <div class="pcard-top">
            <span class="ico" set:html={ICONS[v.icon] ?? ICONS.research} />
            <span class="mono">{v.category}</span>
          </div>
          <h3>{v.title}</h3>
          <p>{v.summary}</p>
          {v.featured && (
            <figure class="jcurve" aria-label="Illustrative J-curve">
              <svg viewBox="0 0 260 112" aria-hidden="true">
                <line class="ax" x1="14" y1="46" x2="252" y2="46" stroke-dasharray="3 4" />
                <line class="ax" x1="14" y1="8" x2="14" y2="98" />
                <path class="cv" pathLength="1" d="M14 46 C40 46 50 86 80 86 C104 86 116 62 132 46 C160 20 200 16 252 12" />
                <line class="ax" x1="132" y1="46" x2="132" y2="98" stroke-dasharray="2 3" />
                <circle class="pt" cx="132" cy="46" r="4" />
                <text x="138" y="60">t+6</text>
                <text x="20" y="16">TRADE BALANCE</text>
                <text x="252" y="108" text-anchor="end">MONTHS AFTER DEPRECIATION</text>
                <text x="10" y="108">t</text>
              </svg>
              <figcaption class="mono">Illustrative J-curve · significant at t+6</figcaption>
            </figure>
          )}
          {v.points.length > 0 && <ul class="pts">{v.points.map((p) => <li>{keepFigures(p)}</li>)}</ul>}
          {v.tags.length > 0 && <ul class="chips">{v.tags.map((t) => <li class="chip">{t}</li>)}</ul>}
          <div class="pcard-foot"><span class:list={['status', { live: v.active }]}>{v.status}</span></div>
        </article>
      ))}
    </div>
  </div>
</section>
